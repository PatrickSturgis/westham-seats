# Paste the contents of this file into the Secrets box on Streamlit
# Community Cloud (app menu, Settings, Secrets), with the real values
# filled in. Do not commit the real one.
#
# To run locally against the shared data instead, copy this to
# .streamlit/secrets.toml, which .gitignore already excludes.

DATA_REPO = "Patricksturg/westham-seats-data"
HF_TOKEN = "hf_your_write_token_here"
