# Template only. This file is PUBLIC, so never put real values in it.
#
# Paste these three keys into the Secrets box on Streamlit Community Cloud
# (Advanced settings when deploying, or app menu, Settings, Secrets after),
# with the real values filled in there.
#
# A local copy belongs at .streamlit/secrets.toml, which .gitignore excludes.

DATA_REPO = "your-hf-username/westham-seats-data"
HF_TOKEN = "hf_your_write_token_here"

# The app is public, so this passcode is the only thing keeping strangers
# out. Pick your own. Do NOT use the placeholder below.
APP_PASSCODE = "REPLACE-ME-do-not-use-this-value"
