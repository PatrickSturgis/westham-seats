# Paste the contents of this file into the Secrets box on Streamlit
# Community Cloud (Advanced settings when deploying, or app menu,
# Settings, Secrets afterwards), with the real values filled in.
#
# Do not commit the real one. .gitignore already excludes
# .streamlit/secrets.toml, which is where a local copy would go.

DATA_REPO = "Patricksturg/westham-seats-data"
HF_TOKEN = "hf_your_write_token_here"

# The app is public, so this passcode is what keeps strangers out.
# Change it to whatever the three of you will remember.
APP_PASSCODE = "bubbles-and-irons-1895"
